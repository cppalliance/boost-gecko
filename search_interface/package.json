{
  "name": "boost-gecko",
  "title": "Boost.Gecko",
  "description": "A search interface for Boost.Gecko project",
  "version": "0.1.2",
  "license": "BSL-1.0",
  "author": "Mohammad Nejati",
  "homepage": "https://github.com/cppalliance/boost-gecko",
  "repository": {
    "type": "git",
    "url": "https://github.com/cppalliance/boost-gecko.git"
  },
  "files": [
    "dist/*",
    "src/*"
  ],
  "dependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@mui/icons-material": "^5.16.7",
    "@mui/lab": "^5.0.0-alpha.133",
    "@mui/material": "^5.16.7",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "algoliasearch": "^4.24.0",
    "nth-check": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-instantsearch": "^7.13.8",
    "recent-searches": "^1.0.5",
    "url-join": "^5.0.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "format": "prettier --write ./src",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "prettier": {
    "tabWidth": 2,
    "trailingComma": "all",
    "singleQuote": true,
    "jsxSingleQuote": true,
    "printWidth": 120
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@svgr/cli": "^8.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^2.8.8",
    "vite": "^6.2.6"
  },
  "overrides": {
    "nth-check": "$nth-check"
  }
}
