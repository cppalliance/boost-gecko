{
  "name": "boost-gecko",
  "title": "Boost.Gecko",
  "description": "A search interface for Boost.Gecko project",
  "version": "0.1.2",
  "license": "BSL-1.0",
  "author": "Mohammad Nejati",
  "homepage": "https://github.com/cppalliance/boost-gecko",
  "repository": {
    "type": "git",
    "url": "https://github.com/cppalliance/boost-gecko.git"
  },
  "files": [
    "dist/*",
    "src/*"
  ],
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.1",
    "@mui/lab": "^7.0.0-beta.16",
    "@mui/material": "^7.3.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "algoliasearch": "^5.35.0",
    "nth-check": "^2.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-instantsearch": "^7.16.2",
    "recent-searches": "^1.0.5",
    "url-join": "^5.0.0",
    "web-vitals": "^5.1.0"
  },
  "scripts": {
    "format": "prettier --write ./src",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "prettier": {
    "tabWidth": 2,
    "trailingComma": "all",
    "singleQuote": true,
    "jsxSingleQuote": true,
    "printWidth": 120
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@svgr/cli": "^8.1.0",
    "@vitejs/plugin-react": "^5.0.1",
    "prettier": "^3.6.2",
    "vite": "^7.1.3"
  },
  "overrides": {
    "nth-check": "$nth-check"
  }
}
